# Fins de ligne normalisées
* text=auto eol=lf
*.bat text eol=crlf

# Gros fichiers via Git LFS
# Images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
# Sons
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
# Vidéos
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
# 3D
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# Polices
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Exception : petites images (< 200 Ko) du jeu et de l'artefact, rangées directement dans Git
# (le service LFS n'est pas joignable depuis les séances Claude dans le cloud).
game/art/*.jpg -filter -diff -merge binary
tools/artefact/*.jpg -filter -diff -merge binary
game/art/*.glb -filter -diff -merge binary
game/art/*.png -filter -diff -merge binary
game/art/*.scn -filter -diff -merge binary
sources/*.glb -filter -diff -merge binary
game/art/arbres/* -filter -diff -merge binary
sources/tree_pack_1.1/** -filter -diff -merge binary
game/art/accessoires/* -filter -diff -merge binary
game/art/*.wav -filter -diff -merge binary
game/art/*.ogg -filter -diff -merge binary
sources/*.mp3 -filter -diff -merge binary
docs/audit/** -filter -diff -merge binary
